# dependencies
node_modules/
.pnp
.pnp.js

# builds
.next/
out/
build/
*.tsbuildinfo
# next-env.d.ts is generated but committed by convention — Next regenerates it,
# and editors rely on it for the ambient Next types.

# local database (superseded by Cloud SQL — never commit)
data/

# runtime uploads (superseded by Cloud Storage)
public/uploads/

# secrets — never commit
.env
.env.*
!.env.example
*-service-account.json
gcp-key.json

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/
.vercel
