# Copy to .env.local for local development. Never commit the filled-in version.

# --- Required ---

# Postgres connection string.
# Local dev (docker compose up):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fosterawag
# Cloud Run (Unix socket via the Cloud SQL connector) — store in Secret Manager, not here:
# DATABASE_URL=postgresql://USER:PASSWORD@/fosterawag?host=/cloudsql/PROJECT:REGION:INSTANCE

# Session cookie encryption key. Minimum 32 characters.
# Generate with: openssl rand -base64 32
# The app refuses to start in production without this.
SESSION_SECRET=

# --- Storage ---

# Google Cloud Storage bucket for pet and foster photos.
# Leave unset in local development to fall back to on-disk uploads under public/uploads.
GCS_BUCKET=

# Serve uploads through a public bucket URL instead of signed URLs.
# Set to "true" only if the bucket is intentionally public-read.
GCS_PUBLIC_READ=false

# Only needed when running outside GCP (locally). On Cloud Run the attached
# service account is used automatically.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Optional ---

# Allow the seed script to run. Guards against seeding a real database.
# ALLOW_SEED=true
